{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal ID local decoder JSON result, v0.2 (shape only)",
  "description": "Schema compliance does not establish an authentic radio protocol decode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decoder_id",
    "version",
    "status",
    "text",
    "tokens",
    "frames",
    "soft_bits",
    "evidence",
    "note",
    "source"
  ],
  "properties": {
    "decoder_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "decoded",
        "partial",
        "no_decode"
      ]
    },
    "text": {
      "type": "string"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "start_sample",
          "end_sample",
          "pattern",
          "confidence_hint"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 0
          },
          "pattern": {
            "type": "string"
          },
          "confidence_hint": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object"
    },
    "note": {
      "type": "string"
    },
    "source": {
      "const": "sigid-independent-implementation"
    },
    "frames": {
      "type": "array",
      "maxItems": 32,
      "description": "Candidate frames; passing CRC/FEC does not verify protocol identity.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_sample",
          "end_sample",
          "payload_base64",
          "encoding",
          "byte_count",
          "bit_length",
          "protocol_hint",
          "integrity",
          "note"
        ],
        "properties": {
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "payload_base64": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "encoding": {
            "const": "base64"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8192
          },
          "bit_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "protocol_hint": {
            "type": "string",
            "maxLength": 100
          },
          "integrity": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "algorithm",
                "outcome",
                "corrected_bits",
                "note"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "crc",
                    "fec",
                    "checksum",
                    "parity"
                  ]
                },
                "algorithm": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "not_checked"
                  ]
                },
                "corrected_bits": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "note": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "soft_bits": {
      "type": "array",
      "maxItems": 16,
      "description": "Bit soft evidence with original sample extents; LLR sign convention is positive = bit 1.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_sample",
          "end_sample",
          "encoding",
          "values",
          "bit_count",
          "note"
        ],
        "properties": {
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "encoding": {
            "enum": [
              "llr_positive_is_one",
              "probability_one"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8192,
            "items": {
              "type": "number"
            }
          },
          "bit_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
