# Linux Compose defaults: web and host Fldigi both on loopback.
SIG_ID_HOST=127.0.0.1
SIG_ID_PORT=8010
SIG_ID_FLDIGI_URL=http://127.0.0.1:7362/RPC2
# Optional artifact inside the persistent volume; leave blank for manual operation.
SIG_ID_MODEL_PATH=
# Optional YOLO artifact in the persistent volume; requires installing with the cv extra.
SIG_ID_CV_MODEL_PATH=
# Optional nearest-neighbor index built from reviewed regions with the same model.
SIG_ID_CV_EMBEDDING_INDEX=
# Set to 1 to build the optional CV runtime into the Compose image.
SIG_ID_INSTALL_CV=0
# Optional AMD GPU container stack. Use with `docker compose -f compose.yaml -f compose.rocm.yaml ...`.
SIG_ID_ROCM_PYTORCH_IMAGE=rocm/pytorch:rocm10.1.0_ubuntu24.04_py3.12_pytorch_release_2.13.0@sha256:b11c021675620aa82d1eaa2d1e78387dde7521bb5b972ce0ad47b6b004d4e7aa
SIG_ID_ROCM_VIDEO_GID=44
SIG_ID_ROCM_RENDER_GID=109
SIG_ID_ROCM_SHM_SIZE=8g
# Optional Laya System One backend for the selected-region "Auto ID with Laya" action.
# Set LAYA_ENDPOINT to the full System One URL; the API key is optional for local endpoints.
LAYA_ENDPOINT=
LAYA_API_KEY=
SIG_ID_LAYA_REFERENCE_SET=
